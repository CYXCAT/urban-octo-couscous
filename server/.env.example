# Port used by local development only. Production runs as a Vercel Function.
PORT=8787

# Production storage. The Vercel Neon integration supplies this automatically.
DATABASE_URL=

# iOS Google OAuth client. The bundle ID must be laowu.hajimi.
GOOGLE_CLIENT_ID=107833156473-ckhr78k7vplu3rfgppn62825h6ipph7u.apps.googleusercontent.com

# OpenAI-compatible API. DeepSeek, OpenRouter, Groq, and similar services also work.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional system prompt added to each conversation.
# LLM_SYSTEM_PROMPT=You are hajimi, a concise and helpful assistant. Reply in the user’s language.
