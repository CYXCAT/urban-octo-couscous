# 服务监听端口。手机和模拟器都通过这个端口连接。
PORT=8787

# iOS 类型的 Google OAuth 客户端。Bundle ID 必须是 laowu.hajimi。
GOOGLE_CLIENT_ID=107833156473-ckhr78k7vplu3rfgppn62825h6ipph7u.apps.googleusercontent.com

# OpenAI 兼容接口。也可以换成 DeepSeek、OpenRouter、Groq 等。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 可选。对话时附加的系统提示。
# LLM_SYSTEM_PROMPT=你是 hajimi，一个简洁、有用的助手。使用用户所用的语言回答。
